# Access token for the Pinterest account this server acts on behalf of.
# Obtain one using the local browser bootstrap or Pinterest developer dashboard.
PINTEREST_ACCESS_TOKEN=

# App credentials, from https://developers.pinterest.com/apps/
# Only needed to run the OAuth flow or refresh an expired token.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=

# Set to 1 to target the Pinterest sandbox instead of production.
PINTEREST_SANDBOX=0

# Attempts for retryable GET failures (429 / 5xx). Writes are not retried.
PINTEREST_MAX_RETRIES=3

# HTTP transport only.
PORT=3000

# Base URL used to build the /auth/callback redirect when PINTEREST_REDIRECT_URI
# is unset. Set this when running behind a proxy or on a hosting platform.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Seals the OAuth tokens this server issues to MCP clients. Required for a hosted
# multi-user deployment: without it a random key is generated at boot and every
# issued token stops working on restart. Use 32+ random characters.
MCP_AUTH_SECRET=

# Local-only listener by default. Compose binds internally to 0.0.0.0 but
# exposes only host loopback. Never expose HTTP publicly without an auth review.
HOST=127.0.0.1
DATA_DIR=./data
TZ=Asia/Ho_Chi_Minh
# Production requires PUBLIC_BASE_URL and MCP_AUTH_SECRET (32+ random chars).
# A server access token applies only to stdio; HTTP requires a caller credential.
# No scheduler or publishing worker exists in Phase 1.
